{
  "name": "lipp-hq-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Escritório virtual 3D da Lipp HQ, renderizado com Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "qa:capture": "node scripts/visual-qa/capture.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
